---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
---

<Base title="Página no encontrada (404) | llamalaweb" description="La página que buscas no existe. Vuelve al inicio o explora nuestros planes y portafolio.">
  <Nav />
  <main id="contenido" class="container-x py-24 sm:py-32">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow">Error 404</span>
      <h1 class="section-title mt-6">
        Ups, esta página <span class="text-grape">no existe</span>.
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink/70">
        Puede que la URL haya cambiado o que el enlace esté mal escrito.
        No te preocupes: te ayudamos a volver al camino.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">
          <Icon name="home" class="h-4 w-4" />
          Volver al inicio
        </a>
        <a href="/#planes" class="btn btn-secondary">Ver planes</a>
        <a href="/#portafolio" class="btn btn-secondary">Portafolio</a>
      </div>

      <div class="reveal mt-12 rounded-[1.75rem] border-2 border-ink bg-white p-6 text-left shadow-pop-sm sm:p-8">
        <p class="font-display text-sm font-bold uppercase tracking-wider text-ink/70">
          ¿Buscabas algo en particular?
        </p>
        <ul class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
          <li>
            <a href="/#contacto" class="link-underline">Contáctanos</a>
            <span class="block text-ink/60">Cuéntanos tu proyecto.</span>
          </li>
          <li>
            <a href="/blog" class="link-underline">Blog</a>
            <span class="block text-ink/60">Guías de diseño web y ventas.</span>
          </li>
          <li>
            <a href="/#faq" class="link-underline">Preguntas frecuentes</a>
            <span class="block text-ink/60">Tiempos, precios y proceso.</span>
          </li>
          <li>
            <a href="mailto:hola.llamalaweb@gmail.com" class="link-underline">Escríbenos</a>
            <span class="block text-ink/60">hola.llamalaweb@gmail.com</span>
          </li>
        </ul>
      </div>
    </div>
  </main>
  <Footer />
</Base>
